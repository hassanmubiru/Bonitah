# WalletConnect Cloud project id used by RainbowKit for WalletConnect wallets.
# Obtain one at https://cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional custom Base Sepolia (chain 84532) JSON-RPC endpoint. When empty the
# public Base Sepolia RPC is used.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
