# ---------------------------------------------------------------------------
# Bonitah Financial Network - Backend environment variables (example)
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# All secret values MUST be supplied via the environment (Req 16.7).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# HTTP
# Comma-separated list of allowed CORS origins (use exact origins in prod).
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL) - source of off-chain data only (Req 1.3)
DATABASE_URL=postgresql://bfn:bfn@localhost:5432/bfn?schema=public

# Redis - read-through cache / queues
REDIS_URL=redis://localhost:6379

# Blockchain (Base Sepolia, chain id 84532) - source of truth for financial state
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Auth (SIWE / JWT) - wired in a later task; secret must be >= 32 chars
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# OpenAI (AI assistant) - wired in a later task
OPENAI_API_KEY=
