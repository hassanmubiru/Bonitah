    "@types/supertest": "^6.0.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
